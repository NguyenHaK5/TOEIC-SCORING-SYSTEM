# Copy thanh .env va dien gia tri that. KHONG commit file .env vao git.

# URL goc cua Toeic.Api (.NET backend). Vi du dev: https://localhost:5443
BACKEND_BASE_URL=https://localhost:58372

# Tai khoan RATER rieng danh cho Evaluation Service (tao qua POST /auth/register-staff
# voi ADMIN token). KHONG dung tai khoan cua nguoi that de de audit/thu hoi rieng.
EVAL_SERVICE_USERNAME=eval-service
EVAL_SERVICE_PASSWORD=Password@123

# Backend dev dung self-signed cert (xem README goc dung "curl -k") -> false o dev.
# PHAI doi thanh true khi tro vao backend production co cert hop le.
BACKEND_VERIFY_SSL=false

# So dong moi trang khi goi endpoint comparison (phan trang).
BACKEND_PAGE_SIZE=100

# Timeout (giay) cho moi HTTP call sang backend.
BACKEND_REQUEST_TIMEOUT_SECONDS=30
