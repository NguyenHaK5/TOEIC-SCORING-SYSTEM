# docker/.env.example
# Copy thành docker/.env rồi điền giá trị thật. KHÔNG commit file .env (đã có
# trong .gitignore ở root — kiểm tra lại nếu chưa). Đúng nguyên tắc #8 prompt
# gốc: không hard-code secret.

# ---------- PostgreSQL ----------
POSTGRES_DB=toeic
POSTGRES_USER=toeic_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ---------- Backend (.NET) ----------
BACKEND_PORT=8080
# Sinh key thật bằng: openssl rand -base64 48
JWT_KEY=change-me-to-a-real-48-byte-base64-secret
JWT_ACCESS_TOKEN_MINUTES=30

# Bootstrap tài khoản ADMIN đầu tiên (DbSeeder — Phase 1 Part 3). Để trống nếu
# đã tạo ADMIN qua cách khác; DbSeeder chỉ chạy khi đủ 3 giá trị VÀ chưa có
# user ADMIN nào.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# LLM Provider cho AI Writing Assessment (Phase 3)
LLM_PROVIDER=Anthropic
LLM_API_KEY=change-me-real-api-key
LLM_MODEL=claude-sonnet-4-6

# ---------- Evaluation Service (Python) ----------
EVALUATION_PORT=8000
# Tài khoản RATER dedicated (tạo qua /auth/register-staff sau khi backend chạy
# lần đầu — xem PHASE5_PART1_INTEGRATION_GUIDE.md và mục "Việc tiếp theo" B.5
# trong phase-tracker.md)
EVAL_RATER_USERNAME=eval-service
EVAL_RATER_PASSWORD=change-me-strong-password

# ---------- Frontend (Next.js) ----------
FRONTEND_PORT=3000
REFRESH_COOKIE_TTL_DAYS=7
# false cho local Docker Compose (http). Đổi true khi có HTTPS thật (Phase 8 Part 3 — Cloud).
COOKIE_SECURE=false
